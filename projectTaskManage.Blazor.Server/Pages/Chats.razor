@page "/Chats"
@using DevExpress.Data.Filtering
@using DevExpress.ExpressApp
@using System.Reflection
@inject LangChainService LangChainService
@inject IObjectSpaceFactory ObjectSpaceFactory
@inject ILogger<Chat> Logger

<div class="chat-wrapper">

    <!-- Header -->
    <div class="chat-header">
        <h4>🤖 AI Assistant</h4>
        <span class="subtitle">Natural Language CRUD for XAF</span>
    </div>
    <!-- Input Area -->
    <div class="chat-input-area">
        <textarea @bind="UserMessage"
                  placeholder="Type your command... (e.g., create employee named John)"
                  rows="2"
                  class="chat-textarea">
        </textarea>

        <button class="send-btn"
                @onclick="SendMessage">
            Send
        </button>
    </div>
    <!-- Chat Body -->
    <div class="chat-body">

        @if (!string.IsNullOrWhiteSpace(ResponseMessage))
        {
            <div class="ai-response-card">
                <div class="ai-label">AI Response</div>
                <pre>@ResponseMessage</pre>
            </div>
        }

        @if (GridData != null && GridType != null)
        {
            var props = GetSafeProperties(GridType);

            <div class="grid-card">

                <div class="grid-title">
                    📊  @GridType.Name - @GridData.Count record(s)
                </div>

                <div class="table-wrapper">
                <div class="table-responsive">
                    <table class="table table-hover custom-table">
                        <thead>
                            <tr>
                                @foreach (var prop in props)
                                {
                                    <th>@prop.Name</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in GridData)
                            {
                                <tr>
                                    @foreach (var prop in props)
                                    {
                                        <td>@GetSafeValue(prop, item)</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                </div>
            </div>
        }

    </div>
</div>

@code {

    private List<PropertyInfo> GetSafeProperties(Type type)
    {
        return type.GetProperties()
            .Where(p =>
                p.CanRead &&
                p.Name != "GCRecord" &&
                p.Name != "OptimisticLockField" &&
                p.Name != "Oid")
            .ToList();
    }

    private object GetSafeValue(PropertyInfo prop, object item)
    {
        try
        {
            var value = prop.GetValue(item);

            if (value == null)
                return null;

            // 🔥 COLLECTION HANDLING
            if (value is System.Collections.IEnumerable enumerable &&
                !(value is string))
            {
                var list = enumerable.Cast<object>().ToList();
                if (!list.Any()) return "[]";

                var displayValues = list.Select(x =>
                {
                    // 🔥 Smart fallback for XAF proxy objects

                    var realType = x.GetType().BaseType ?? x.GetType();

                    // 1️⃣ Try common display fields
                    var smartDisplayProp = realType.GetProperties()
                        .FirstOrDefault(p =>
                            p.PropertyType == typeof(string) &&
                            !string.IsNullOrWhiteSpace(p.GetValue(x)?.ToString()));

                    if (smartDisplayProp != null)
                    {
                        return smartDisplayProp.GetValue(x)?.ToString();
                    }

                    // 2️⃣ Try Oid / ID
                    var idProp = realType.GetProperty("Oid") ??
                                 realType.GetProperty("ID") ??
                                 realType.GetProperty("Id");

                    if (idProp != null)
                    {
                        var idVal = idProp.GetValue(x)?.ToString();
                        if (!string.IsNullOrWhiteSpace(idVal))
                            return idVal;
                    }

                    // 3️⃣ Final safe fallback
                    return "[Related Item]";
                })
                .Where(v => !string.IsNullOrWhiteSpace(v));

                return string.Join(", ", displayValues);
            }

            // 🔥 REFERENCE HANDLING
            if (!prop.PropertyType.IsPrimitive &&
                prop.PropertyType != typeof(string) &&
                !prop.PropertyType.IsValueType)
            {
                var nameProp = prop.PropertyType
                    .GetProperties()
                    .FirstOrDefault(p =>
                        p.PropertyType == typeof(string) &&
                        p.Name.ToLower().Contains("name"));

                if (nameProp != null)
                {
                    var displayVal = nameProp.GetValue(value)?.ToString();
                    if (!string.IsNullOrWhiteSpace(displayVal))
                        return displayVal;
                }

                // fallback to Oid
                var idProp = value.GetType().GetProperty("Oid") ??
                             value.GetType().GetProperty("ID");

                if (idProp != null)
                {
                    return idProp.GetValue(value)?.ToString();
                }

                return "[Reference]";
            }

            return value;
        }
        catch
        {
            return null;
        }
    }

    string UserMessage;
    string ResponseMessage;

    List<object> GridData;
    Type GridType;

    async Task SendMessage()
    {
        try
        {
            var result = await LangChainService.ParseAsync(UserMessage);

            if (result == null)
            {
                ResponseMessage = "❌ Could not understand command.";
                return;
            }

            await ExecuteCrud(result);

            Logger.LogInformation("AI Command Executed: {@Command}", result);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "AI Execution Failed");
            ResponseMessage = $"❌ Error: {ex.Message}";
        }
    }

    // my AI Router which takes the parsed command and executes the appropriate CRUD operation
    private async Task ExecuteCrud(CrudCommand command)
    {
        var entityType = ResolveEntityType(command.Entity);

        if (entityType == null)
        {
            ResponseMessage = $"❌ Unknown entity: {command.Entity}";
            return;
        }

        using var objectSpace = ObjectSpaceFactory.CreateObjectSpace(entityType);
        Logger.LogInformation("AI Command: {@Command}", command);
        Logger.LogInformation("AI Filters: {@Filters}", command.Filters);
        if ((command.Action == "delete" || command.Action == "update") &&
    (command.Filters == null || !command.Filters.Any()))
        {
            ResponseMessage = "❌ WHERE condition required.";
            return;
        }
        switch (command.Action.ToLower())
        {
            case "create":
                await HandleCreate(command, entityType, objectSpace);
                break;

            case "read":
                await HandleRead(entityType, objectSpace);
                break;

            case "update":
                await HandleUpdate(command, entityType, objectSpace);
                break;

            case "delete":
                await HandleDelete(command, entityType, objectSpace);
                break;

            default:
                ResponseMessage = $"❌ Unknown action: {command.Action}";
                break;
        }
    }

