    private async Task HandleCreate(
    CrudCommand command,
    Type entityType,
    IObjectSpace objectSpace)
    {
        try
        {
            var entity = objectSpace.CreateObject(entityType);

            foreach (var field in command.Fields)
            {
                var prop = ResolveProperty(entityType, field.Key);
                if (prop == null) continue;

                var propType = prop.PropertyType;

                // 🔥 Reference handling (Organization, ProjectManager)
                if (!propType.IsPrimitive &&
                    propType != typeof(string) &&
                    !propType.IsEnum &&
                    !propType.IsValueType)
                {
                    var related = FindRelatedObject(
                        propType,
                        field.Value?.ToString(),
                        objectSpace);

                    if (related != null)
                        prop.SetValue(entity, related);
                }
                else
                {
                    var value = ConvertJsonValue(field.Value, propType);
                    prop.SetValue(entity, value);
                }
            }

            // 🔥 Auto set StartDate if missing
            var startDateProp = entityType.GetProperty("StartDate");
            if (startDateProp != null)
            {
                var currentValue = startDateProp.GetValue(entity);

                if (currentValue is DateTime dt && dt == default)
                {
                    startDateProp.SetValue(entity, DateTime.Now);
                }
            }

            objectSpace.CommitChanges();

            GridData = new List<object> { entity };
            GridType = entityType;

            ResponseMessage = $"✅ {command.Entity} created successfully.";
        }
        catch (Exception ex)
        {
            objectSpace.Rollback();
            ResponseMessage = $"❌ Create failed: {ex.InnerException?.Message ?? ex.Message}";
        }

        await Task.CompletedTask;
    }



    // -------------------- READ --------------------
    // my AI Read handler which retrieves all records of the specified entity type and displays them in a grid
    private async Task HandleRead(Type entityType, IObjectSpace objectSpace)
    {
        var objects = objectSpace
            .GetObjects(entityType)
            .Cast<object>()
            .ToList();

        foreach (var obj in objects)
        {
            foreach (var prop in entityType.GetProperties())
            {
                var value = prop.GetValue(obj);

                // 🔥 Force load reference objects
                if (value != null &&
                    !prop.PropertyType.IsPrimitive &&
                    prop.PropertyType != typeof(string) &&
                    !prop.PropertyType.IsValueType)
                {
                    _ = value.ToString();
                }

                // 🔥 Force load collections
                if (value is System.Collections.IEnumerable enumerable &&
                    !(value is string))
                {
                    var list = enumerable.Cast<object>().ToList();
                }
            }
        }

        GridData = objects;
        GridType = entityType;

        ResponseMessage = $"📊 Found {GridData.Count} record(s).";

        await Task.CompletedTask;
    }


    // -------------------- UPDATE --------------------
    // my AI Update handler which applies filters based on the command fields to find matching records, updates their properties, and saves the changes


    private async Task HandleUpdate(
        CrudCommand command,
        Type entityType,
        IObjectSpace objectSpace)
    {
        try
        {
            if (command.Filters == null || !command.Filters.Any())
            {
                ResponseMessage = "❌ WHERE condition required for update.";
                return;
            }

            var criteria = BuildCriteria(command, entityType);

            var objects = objectSpace
                .GetObjects(entityType, criteria)
                .Cast<object>()
                .ToList();

            if (!objects.Any())
            {
                ResponseMessage = "❌ No matching record found.";
                return;
            }

            foreach (var entity in objects)
            {
                foreach (var field in command.Fields)
                {
                    var prop = ResolveProperty(entityType, field.Key);
                    if (prop == null) continue;

                    var propType = prop.PropertyType;

                    // 🔥 COLLECTION HANDLING (Tasks, Files, etc.)
                    if (typeof(System.Collections.IEnumerable).IsAssignableFrom(propType)
                        && propType != typeof(string))
                    {
                        HandleCollectionAssignment(
                            entity,
                            prop,
                            field.Value,
                            objectSpace);
                    }
                    // 🔥 REFERENCE HANDLING (Organization, User, etc.)
                    else if (!propType.IsPrimitive &&
                             propType != typeof(string) &&
                             !propType.IsEnum &&
                             !propType.IsValueType)
                    {
                        var relatedObject = FindRelatedObject(
                            propType,
                            field.Value?.ToString(),
                            objectSpace);

                        if (relatedObject != null)
                            prop.SetValue(entity, relatedObject);
                    }
                    // 🔥 SIMPLE PROPERTY
                    else
                    {
                        var value = ConvertJsonValue(field.Value, propType);
                        prop.SetValue(entity, value);
                    }
                }
            }

            objectSpace.CommitChanges();

            GridData = objects;
            GridType = entityType;

            ResponseMessage = $"✏️ Updated {objects.Count} record(s).";
        }
        catch (Exception ex)
        {
            objectSpace.Rollback();
            ResponseMessage = $"❌ Update failed: {ex.Message}";
        }

        await Task.CompletedTask;
    }


    private object FindRelatedObject(
    Type targetType,
    string value,
    IObjectSpace objectSpace)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null;

        // Try string display property first
        var stringProp = targetType.GetProperties()
            .FirstOrDefault(p =>
                p.PropertyType == typeof(string));

        if (stringProp != null)
        {
            var criteria = new BinaryOperator(
                stringProp.Name,
                value,
                BinaryOperatorType.Equal);

            return objectSpace
                .GetObjects(targetType, criteria)
                .Cast<object>()
                .FirstOrDefault();
        }

        // Fallback: try Oid
        var idProp = targetType.GetProperty("Oid")
                   ?? targetType.GetProperty("Id");

        if (idProp != null)
        {
            var converted = Convert.ChangeType(value, idProp.PropertyType);

            var criteria = new BinaryOperator(
                idProp.Name,
                converted,
                BinaryOperatorType.Equal);

            return objectSpace
                .GetObjects(targetType, criteria)
                .Cast<object>()
                .FirstOrDefault();
        }

        return null;
    }

    private void HandleCollectionAssignment(
    object parent,
    PropertyInfo collectionProperty,
    object value,
    IObjectSpace objectSpace)
    {
        var collection = collectionProperty.GetValue(parent)
            as System.Collections.IList;

        if (collection == null) return;

        var itemType = collectionProperty.PropertyType
            .GetGenericArguments()
            .FirstOrDefault();

        if (itemType == null) return;

        var relatedObject = FindRelatedObject(
            itemType,
            value?.ToString(),
            objectSpace);

        if (relatedObject == null) return;

        if (!collection.Contains(relatedObject))
        {
            collection.Add(relatedObject);
        }
    }











    // -------------------- DELETE --------------------
    // my AI Delete handler which applies filters based on the command fields to find matching records and deletes them from the database

    private async Task HandleDelete(CrudCommand command, Type entityType, IObjectSpace objectSpace)
    {
        try
        {
            // 🚨 HARD SAFETY BLOCK
            if (command.Filters == null || !command.Filters.Any())
            {
                ResponseMessage = "❌ WHERE condition required for delete.";
                return;
            }

            // Build database filter (same as update)
            var criteria = BuildCriteria(command, entityType);

            if (criteria == null)
            {
                ResponseMessage = "❌ Invalid filter.";
                return;
            }

            var objects = objectSpace
                .GetObjects(entityType, criteria)
                .Cast<object>()
                .ToList();

            if (!objects.Any())
            {
                ResponseMessage = "❌ No matching record found.";
                return;
            }

            foreach (var entity in objects)
            {
                objectSpace.Delete(entity);
            }

            objectSpace.CommitChanges();

            await HandleRead(entityType, objectSpace);

            ResponseMessage = $"🗑️ Deleted {objects.Count} record(s).";
        }
        catch (Exception ex)
        {
            objectSpace.Rollback();
            ResponseMessage = $"❌ Delete failed: {ex.Message}";
        }
    }




    // -------------------- SMART PROPERTY RESOLUTION --------------------

    private PropertyInfo ResolveProperty(Type type, string fieldName)
    {
        var properties = type.GetProperties();

        var cleanedField = Clean(fieldName);

        // 1️⃣ Exact match
        var exact = properties.FirstOrDefault(p =>
            string.Equals(p.Name, fieldName, StringComparison.OrdinalIgnoreCase));

        if (exact != null)
            return exact;

        // 2️⃣ Cleaned match (remove spaces, case insensitive)
        var cleanedMatch = properties.FirstOrDefault(p =>
            Clean(p.Name) == cleanedField);

        if (cleanedMatch != null)
            return cleanedMatch;

        // 3️⃣ Partial match (field contained in property)
        var partial = properties.FirstOrDefault(p =>
            Clean(p.Name).Contains(cleanedField));

        if (partial != null)
            return partial;

        // 4️⃣ Reverse partial match (property contained in field)
        partial = properties.FirstOrDefault(p =>
            cleanedField.Contains(Clean(p.Name)));

        if (partial != null)
            return partial;

        // 5️⃣ Smart "Name" logic (MOST IMPORTANT)
        if (cleanedField == "name")
        {
            var nameProp = properties.FirstOrDefault(p =>
                Clean(p.Name).Contains("name"));

            if (nameProp != null)
                return nameProp;
        }

        // 6️⃣ Fallback: First string property (AI heuristic)
        var firstString = properties.FirstOrDefault(p =>
            p.PropertyType == typeof(string));

        return firstString;
    }

    private string Clean(string value)
    {
        return value?
            .Replace(" ", "")
            .Replace("_", "")
            .Replace("-", "")
            .Replace(".", "")
            .ToLower()
            .Trim();
    }




